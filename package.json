{
  "name": "bookworm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:rls && npm run test:e2e",
    "test:unit": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.js",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
